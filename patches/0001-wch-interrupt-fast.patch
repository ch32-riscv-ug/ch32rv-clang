diff -ruN a/llvm/lib/Target/RISCV/RISCVCallingConv.td b/llvm/lib/Target/RISCV/RISCVCallingConv.td
--- a/llvm/lib/Target/RISCV/RISCVCallingConv.td	2026-11-12 07:36:39.375790382 +0900
+++ b/llvm/lib/Target/RISCV/RISCVCallingConv.td	2026-11-12 07:36:57.869821116 +0900
@@ -96,6 +96,18 @@
 def CSR_XLEN_F64_V_Interrupt_RVE: CalleeSavedRegs<(sub CSR_XLEN_F64_V_Interrupt,
                                                    (sequence "X%u", 16, 31))>;
 
+// WCH-Interrupt-fast: the QingKe core's HPE saves and restores ra, t0-t6 and
+// a0-a7 (ra, t0-t2 and a0-a5 on RV32E) itself, so the handler saves the
+// rest: the callee-saved integer registers and the floating-point registers.
+defvar WCH_HPE_Saved = (add X1, (sequence "X%u", 5, 7), (sequence "X%u", 10, 17),
+                            (sequence "X%u", 28, 31));
+def CSR_WCH_Interrupt : CalleeSavedRegs<(sub CSR_Interrupt, WCH_HPE_Saved)>;
+def CSR_WCH_F32_Interrupt : CalleeSavedRegs<(sub CSR_XLEN_F32_Interrupt, WCH_HPE_Saved)>;
+def CSR_WCH_F64_Interrupt : CalleeSavedRegs<(sub CSR_XLEN_F64_Interrupt, WCH_HPE_Saved)>;
+def CSR_WCH_Interrupt_RVE : CalleeSavedRegs<(sub CSR_Interrupt_RVE, WCH_HPE_Saved)>;
+def CSR_WCH_F32_Interrupt_RVE : CalleeSavedRegs<(sub CSR_XLEN_F32_Interrupt_RVE, WCH_HPE_Saved)>;
+def CSR_WCH_F64_Interrupt_RVE : CalleeSavedRegs<(sub CSR_XLEN_F64_Interrupt_RVE, WCH_HPE_Saved)>;
+
 def CSR_RT_MostRegs : CalleeSavedRegs<(sub CSR_Interrupt, X6, X7, X28)>;
 def CSR_RT_MostRegs_RVE : CalleeSavedRegs<(sub CSR_RT_MostRegs,
                                                (sequence "X%u", 16, 31))>;
